{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts tests/*.test.mts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "npx tsx scripts/seed.ts",
    "contract:compile": "cd move && aptos move compile --dev",
    "contract:test": "cd move && aptos move test --dev",
    "db:indexes": "tsx --env-file=.env scripts/ensure-indexes.ts",
    "e2e": "tsx --env-file=.env scripts/e2e-datasets.mts",
    "e2e:cleanup": "tsx --env-file=.env scripts/e2e-cleanup.mts",
    "mcp": "tsx scripts/forge-mcp.mts",
    "e2e:agents": "tsx --env-file=.env scripts/e2e-agents.mts",
    "e2e:sponsor": "tsx --env-file=.env scripts/e2e-sponsor.mts",
    "upload-dataset": "tsx scripts/forge-upload.mts",
    "originality": "tsx --env-file=.env scripts/originality-dev.mts",
    "test:originality": "cd services/originality && python -m unittest discover -s tests -t .",
    "e2e:email": "tsx --env-file=.env scripts/e2e-email-account.mts"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^5.2.1",
    "@aptos-labs/wallet-adapter-ant-design": "^5.3.19",
    "@aptos-labs/wallet-adapter-core": "^8.5.1",
    "@aptos-labs/wallet-adapter-react": "^8.3.3",
    "@aptos-labs/wallet-standard": "^2.0.0",
    "@aws-sdk/client-s3": "^3.1066.0",
    "@aws-sdk/s3-request-presigner": "^3.1066.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^5.22.0",
    "@privy-io/node": "0.35.0",
    "@privy-io/react-auth": "3.46.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@shelby-protocol/media-prepare": "^0.0.1",
    "@shelby-protocol/player": "^0.2.0",
    "@shelby-protocol/react": "^4.3.0",
    "@shelby-protocol/sdk": "^0.9.2",
    "@tanstack/react-query": "^5.100.14",
    "@telegram-apps/bridge": "1.9.2",
    "@wallet-standard/core": "^1.1.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "framer-motion": "^12.40.0",
    "got": "11.8.6",
    "jose": "^6.2.3",
    "lucide-react": "^1.17.0",
    "mongodb": "^6.16.0",
    "next": "15.5.26",
    "prisma": "^5.22.0",
    "pusher": "^5.3.3",
    "pusher-js": "^8.5.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.1",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "got": "11.8.6",
    "postcss": "8.5.28",
    "uuid": "11.1.1"
  }
}
