# Copy to .env and fill in. Every variable here is read by the app or its scripts.

# ─── App & database ─────────────────────────────────────────────────────────
MONGODB_URI=
JWT_SECRET=
NEXT_PUBLIC_APP_URL=
# Required by /api/cron/* (agent settlement, memory anchoring, storage reconcile). Set the same value in Vercel.
CRON_SECRET=

# ─── Aptos / ShelbyNet ──────────────────────────────────────────────────────
NEXT_PUBLIC_APTOS_NODE_URL=
NEXT_PUBLIC_APTOS_API_KEY=
NEXT_PUBLIC_APTOS_SHELBYNET_API_KEY=
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_MODULE_ADDRESS=
# Treasury that receives the 5% platform fee.
NEXT_PUBLIC_PLATFORM_ADDRESS=
PLATFORM_FEE_BPS=500
VERIFICATION_COST_APT=10

# ─── Shelby storage ─────────────────────────────────────────────────────────
SHELBY_API_KEY=
NEXT_PUBLIC_SHELBY_SHELBYNET_API_KEY=
NEXT_PUBLIC_SHELBY_GATEWAY=
NEXT_PUBLIC_SHELBY_LOCATION_HINT=shelbynet-1
# Server signer (also the contract deployer and, by default, the agent settlement account).
SHELBY_SIGNER_PRIVATE_KEY=

# ─── Agent pay-per-read & sponsored storage ─────────────────────────────────
# Optional: separate key for the agent settlement / storage sponsor account. Falls back to SHELBY_SIGNER_PRIVATE_KEY.
FORGE_SETTLEMENT_PRIVATE_KEY=
# Fungible asset agents pay with (0xa = APT).
NEXT_PUBLIC_AGENT_PAYMENT_ASSET=0xa
NEXT_PUBLIC_AGENT_PAYMENT_SYMBOL=APT
AGENT_MIN_WITHDRAW_OCTAS=100000
AGENT_MIN_PAYOUT_OCTAS=100000
# Forge pays Shelby storage for sellers. Needs ShelbyUSD on the settlement account.
FORGE_SPONSOR_STORAGE=false
FORGE_SPONSOR_DAILY_BYTES=2147483648

# ─── Contract deployment (scripts/deploy-contract.*) ────────────────────────
APTOS_PROFILE=
FORGE_DEPLOYER_ADDRESS=
FORGE_TREASURY_ADDRESS=0x3b89c6e123ebc9657431c9a9bfac99b0b581610772808ef79ac4d4f7cfc9ae6c

# ─── Realtime (Pusher) ──────────────────────────────────────────────────────
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# ─── Cloud import (legacy upload flow) ──────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# ─── S3 gateway (legacy stream uploads) ─────────────────────────────────────
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Client tooling (agents, MCP, seller CLI): set in the tool's own env ───────
# FORGE_URL=https://your-forge-host
# FORGE_AGENT_SENDER=0x…
# FORGE_AGENT_SESSION_KEY=0x…
# FORGE_MAX_READ_APT=0.01
# FORGE_SELLER_KEY=0x…
# CONFIRM_FORGE_DEPLOYMENT=<deployer>:<treasury>  (deploy script safety check)

# ─── Originality check (Python service in services/originality) ─────────────
# Every upload is scored out of 10 against Forge's catalogue; below 5 is refused.
# Run locally with `npm run originality`; deploy with services/originality/Dockerfile
# (needs DATABASE_URL and the same ORIGINALITY_SERVICE_SECRET).
ORIGINALITY_SERVICE_URL=
ORIGINALITY_SERVICE_SECRET=
# ORIGINALITY_REQUIRED=false   # local development only, skips the check
