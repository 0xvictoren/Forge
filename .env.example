# MongoDB Atlas (Prisma). Include a database name in the URI, e.g.
# mongodb+srv://USER:PASS@cluster.mongodb.net/forge?retryWrites=true&w=majority
MONGODB_URI=
JWT_SECRET=
NEXT_PUBLIC_APP_URL=https://forge-alpha-blush.vercel.app

NEXT_PUBLIC_APTOS_NETWORK=shelbynet
NEXT_PUBLIC_APTOS_NODE_URL=https://api.shelbynet.shelby.xyz/v1
NEXT_PUBLIC_APTOS_API_KEY=
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_MODULE_ADDRESS=
NEXT_PUBLIC_PLATFORM_ADDRESS=

# Shelby (primary storage + ShelbyNet)
SHELBY_API_KEY=                 # Server key (recommended). Falls back to NEXT_PUBLIC_* variants
SHELBY_SIGNER_PRIVATE_KEY=      # REQUIRED for server-side uploads (ed25519-priv-... or 0x...). Must be funded with APT + ShelbyUSD on shelbynet.
NEXT_PUBLIC_SHELBY_GATEWAY=https://gateway.shelby.network

# ShelbyNet API keys (use the ones from Aptos/Shelby dashboard). Both server and browser clients will pick these up.
NEXT_PUBLIC_SHELBY_SHELBYNET_API_KEY=
NEXT_PUBLIC_APTOS_SHELBYNET_API_KEY=
NEXT_PUBLIC_APTOS_SHELBYNET_GAS_STATION_API_KEY=

VERIFICATION_COST_APT=10

PUSHER_APP_ID=
PUSHER_KEY=
NEXT_PUBLIC_PUSHER_KEY=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_CLUSTER=us3

PLATFORM_FEE_BPS=200

# Platform treasury — receives verification fees; 2% fee tracked against this address
NEXT_PUBLIC_PLATFORM_ADDRESS=

# Cloud import OAuth (Google Drive)
# 1. https://console.cloud.google.com/apis/credentials — create OAuth 2.0 Web client
# 2. Enable Google Drive API for the project
# 3. Add authorized redirect URI (must match exactly):
#    https://forge-alpha-blush.vercel.app/api/import/google/callback
#    (local dev: http://localhost:3000/api/import/google/callback)
# 4. JWT_SECRET is required for OAuth state/token cookies
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://forge-alpha-blush.vercel.app/api/import/google/callback
